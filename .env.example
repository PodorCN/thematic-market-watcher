# Copy to .env for local runs (run_all.sh loads it via python-dotenv).
# In CI these are set as GitHub repo secrets instead -- see
# .github/workflows/daily-pipeline.yml.

ANTHROPIC_API_KEY=

# Only needed if you switch a stage in config/llm.yaml to provider: openai
OPENAI_API_KEY=
# Optional: point at an OpenAI-compatible gateway instead of api.openai.com
# OPENAI_BASE_URL=

# Optional: which date's data to operate on (YYYY-MM-DD). Defaults to
# today (UTC) if unset -- see run_all.sh.
# DATE=2026-08-21
